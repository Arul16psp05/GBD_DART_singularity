#####  TEMPO2  #####
%post
    . /etc/bash.bashrc && \
        cd $PSRHOME/src && \
        git clone https://bitbucket.org/psrsoft/tempo2.git

    . /etc/bash.bashrc && \
        cd $PSRHOME/src/tempo2 && \
        ./bootstrap && \
        ./configure --prefix=$PSRHOME && \
        make && \
        make install && \
        make plugins && \
        make plugins-install && \
        cp -r T2runtime/* $TEMPO2/
    date >> installation_log.txt   
    echo 'TEMPO2 instalation over' >> installation_log.txt     

#####  PSRCHIVE  #####
%post
    cd $PSRHOME && \
        git clone http://git.code.sf.net/p/psrchive/code psrchive
 
    cd $PSRHOME/DART_patch_file/psrchive
        mapfile -t file_loc < "file_locations.txt"
        Telescopes_C_file=$PSRHOME'/'${file_loc[0]}
        Telescopes_h_file=$PSRHOME'/'${file_loc[1]}
        itoa_file=$PSRHOME'/'${file_loc[2]}        
        bash Add_DART_telescope_psrchive.sh $Telescopes_C_file $Telescopes_h_file $itoa_file
        
    cd $PSRHOME/psrchive && \
        #git checkout master && \
        #git checkout $GIT_PSRCHIVE_TAG && \
        ./bootstrap
        ./configure --prefix=$PSRHOME --enable-shared --with-x --with-psrcat=psrcat && \
        make -j 6 && \
        make install
    echo '/usr/local/pulsar/lib/python3.10/site-packages' > /usr/local/lib/python3.10/dist-packages/mymodule.pth
    date >> installation_log.txt
    echo 'PSRCHIVE instalation over' >> log.txt

