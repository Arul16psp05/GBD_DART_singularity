#####  Pre Requirements  #####
%post
    cp /packages/fftw-3.2.2.tar.gz $PSRHOME/packages/
    cp /packages/cfitsio-3.49.tar.gz $PSRHOME/packages/
    cp /packages/psrcat_pkg.tar.gz $PSRHOME/packages/
    cp /packages/sofa_c-20231011.tar.gz $PSRHOME/src/
    cp /packages/sigpyproc3-1.2.0.tar.gz $PSRHOME/packages/
    cp /DART_patch_file/psrchive/Add_DART_telescope_psrchive.sh $PSRHOME/DART_patch_file/psrchive/
    cp /DART_patch_file/psrchive/file_locations.txt $PSRHOME/DART_patch_file/psrchive/
    cp /DART_patch_file/psrchive/Telescopes_C_patch_1.C $PSRHOME/DART_patch_file/psrchive/
    cp /DART_patch_file/psrchive/Telescopes_C_patch_2.C $PSRHOME/DART_patch_file/psrchive/   
    cp /DART_patch_file/psrchive/Telescopes_h_patch.h $PSRHOME/DART_patch_file/psrchive/
    cp /DART_patch_file/psrchive/itoa_C_patch.C $PSRHOME/DART_patch_file/psrchive/
    
    export  cfitsio="cfitsio-3.49"
    export  fftw="fftw-3.2.2"
    export  psrcat="psrcat_pkg"
    export  sofa="sofa_c-20231011" 
    export  sigpyproc3="sigpyproc3-1.2.0"

    ###    psrcat_pkg  ###
    tcsh_pkg=`which tcsh`
    gcc_pkg=`which gcc`
    default_gcc="/usr/bin/gcc-9"
    default_tcsh="/usr/bin/tcsh"
    
    cd $PSRHOME/packages/ && \
        tar --no-same-owner -xzvf ${psrcat}.tar.gz && \
        cd psrcat_tar
        #sed -i "s%#!${default_tcsh}%#!${tcsh_pkg}%g" makeit
        #sed -i "s%${default_gcc}%${gcc_pkg}%g" makeit
        #csh makeit
        make psrcat
        mkdir -p $PSRHOME/bin
        mv psrcat $PSRHOME/bin
        mkdir -p $PSRHOME/psrcat
        cp * $PSRHOME/psrcat

    ### sofa ###
    cd $PSRHOME/src/ && \
        gunzip -c ${sofa}.tar.gz | tar xvf -
        cd $PSRHOME/src/sofa/20231011/c/src
        make && make test

    ###    cfitsio-3.49  ###
    cd $PSRHOME/packages/ && \
        gunzip -c ${cfitsio}.tar.gz | tar xvf -
        cd $cfitsio
        ./configure --prefix=$PSRHOME --enable-reentrant
        make clean
        make
        make shared
        make install

    ###    fftw-3.2.2  ###
    cd $PSRHOME/packages/ && \
        gunzip -c ${fftw}.tar.gz | tar xvf -
        cd $fftw
        ./configure --enable-shared --enable-float --enable-sse --disable-dependency-tracking --prefix=$PSRHOME --enable-reentrant
        make clean
        make
        make install   

    ###    sigpyproc3  ###
    cd $PSRHOME/packages/ && \
        gunzip -c ${sigpyproc3}.tar.gz | tar xvf -
        cd $sigpyproc3
        pip3 install .

